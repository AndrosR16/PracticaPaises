@model TicketSystem.DTOs.Movie
@{
    ViewData["Title"] = Model.title;
}

<div class="container mt-4">
    <div class="row">
        <div class="col-md-4">
            <img src="@Model.PosterUrlLarge" alt="@Model.title" class ="img-fluid rounded shadow">
        </div>

        <div class="col-md-8">
            <h1>@Model.title</h1>

            <p class="text-muted">
                Release Date: @Model.release_date
            </p>

            <h4>
                ⭐ @Model.vote_average.ToString("0.0") / 10
            </h4>

            <hr/>

            <h5>Overview</h5>

            <p>@Model.overview</p>

            @if(Model.adult){
                <span class = "badge bg-danger">
                    Adults Only
                </span>
            }

            <div class="mt-4">
                <a asp-controller ="Home" asp-action ="Index" class="btn btn-secondary">Back to Movies</a>
            </div>

        </div>

    </div>



</div>

