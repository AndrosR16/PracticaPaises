@model TicketSystem.DTOs.Usuario

@{
    ViewData["Title"] = "Eliminar Usuario"; 
}

<h4 class="text-danger mb-3">
    Eliminar Usuario
</h4>

<div class="alert alert-warning">
    ¿Esta seguro que desea eliminar este usuario?
</div>

<div class="card">
    <div class="card-body">
    
        <div class="card-title">
            @Model.nombre @Model.apellido
        </div>

        <div class="card-text">
            <strong>Nombre de Usuario: </strong> @Model.nombre_usuario
        </div>

        <p class="card-text">
            <strong>Administrador</strong>

            @if(Model.isAdmin){
                <span>Si</span>
            } else {
                <span>No</span>
            }
        </p>

    </div>
</div>

<form asp-action="DeleteConfirmed" asp-controller ="Usuario" class="mt-3">

    <input type="hidden" name="nombre_usuario" value="@Model.nombre_usuario">

    <button type="submit" class="btn btn-danger">Eliminar</button>
    <a asp-action ="Index" class ="btn btn-secondary">Cancelar</a>

</form>