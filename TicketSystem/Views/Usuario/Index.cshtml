@using TicketSystem.DTOs
@model List<TicketSystem.DTOs.Usuario>

@{
    ViewData["Title"] = "Manejo de Usuarios";

    var nombre_usuario = Context.Session.GetString("userName"); 

    var role_usuario = bool.Parse(
        Context.Session.GetString("userRole") ?? "false"
    );
}

<div class="d-flex justify-content-between align-items-center mb-3">

    <div>
        <h4 class="text-primary">Manejo de Usuarios</h4>
        <small class="text-muted">
            Usuario Actual: @nombre_usuario
        </small>
    </div>

    @if(role_usuario){
        <a class="btn btn-primary" asp-controller ="Usuario" asp-action="Create"> Crear Usuario</a>
    }

</div>

@if(TempData["Success"] != null){

    <div class="aler alert-success">
        @TempData["Success"]
    </div>
}

<table class="table table-striped table-hover">

    <thead>
        <tr>
            <th>Nombre</th>
            <th>Apellido</th>
            <th>Nombre Usuario</th>
            <th>Administrador</th>
            <th class="text-center">Acciones</th>
        </tr>
    </thead>

    <tbody>
        @foreach (Usuario usuario in Model){
            <tr>
                <td>@usuario.nombre</td>
                <td>@usuario.apellido</td>
                <td>@usuario.nombre_usuario</td>
                <td>
                    @if(usuario.isAdmin)
                    {
                        <span class="badge bg-success">
                            Sí
                        </span>
                    } else
                    {
                        <span class="badge bg-secondary">
                            No
                        </span>    
                    }
                </td>
                <td class = "text-center">

                    <a class="btn btn-warning btn-sm" asp-action="Edit" asp-controller="Usuario" asp-route-nombre_usuario = "@usuario.nombre_usuario">Edit</a>
                    <a class="btn btn-danger btn-sm" asp-action="Delete" asp-controller="Usuario" asp-route-nombre_usuario="@usuario.nombre_usuario">Delete</a>

                </td>
            </tr>
        }
    </tbody>

</table>